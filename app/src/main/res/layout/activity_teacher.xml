<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/color1">

    <!-- HEADER VERDE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#00006400">

        <ImageView
            android:id="@+id/iv_perfil_docente"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/foto1"
            android:background="@drawable/circulo_foto"
            android:scaleType="centerCrop"/>

        <ImageView
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:layout_marginStart="70dp"
            android:src="@drawable/logo1" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/btn_cerrar_sesion"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cerrar sesión"
            app:tint="#FFFF" />
    </LinearLayout>

    <!-- CARD BLANCO GRANDE -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="20dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- BOTONES ESTADÍSTICAS / RANKING -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#F5F5F5"
                android:padding="8dp">

                <Button
                    android:id="@+id/btn_estadisticas"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Estadísticas"
                    android:textColor="#006400"
                    android:backgroundTint="#FFFFFF"/>

                <Button
                    android:id="@+id/btn_ranking"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ranking"
                    android:backgroundTint="#FFFFFF"/>
            </LinearLayout>

            <!-- CONTENIDO QUE CAMBIA -->
            <LinearLayout
                android:id="@+id/contenedor_vista"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>