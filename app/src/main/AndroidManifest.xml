<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/logo_verde"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/logo_verde_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ALquemix"
        tools:targetApi="34">

        <!-- ==================== AUTH MODULE ==================== -->
        <activity
            android:name=".auth.RegisterActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".auth.LoginActivity"
            android:exported="false" />

        <!-- ==================== HOME MODULE ==================== -->
        <activity
            android:name=".home.MainActivity"
            android:exported="false" />
        <activity
            android:name=".home.MenuTemasActivity"
            android:exported="false" />
        <activity
            android:name=".home.InfoActivity"
            android:exported="false" />
        <activity
            android:name=".home.MainQuiz"
            android:exported="false" />
        <activity
            android:name=".home.ActualizarPerfilActivity"
            android:exported="false" />

        <!-- ==================== QUIZ MODULE ==================== -->
        <activity
            android:name=".quiz.QuizActivity"
            android:exported="false" />

        <!-- ==================== PROFILE MODULE ==================== -->
        <activity
            android:name=".profile.ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.ALquemix" />

        <!-- ==================== TEACHER MODULE ==================== -->
        <activity
            android:name=".teacher.TeacherActivity"
            android:exported="false" />
        <activity
            android:name=".teacher.TopActivity"
            android:exported="false" />

    </application>

</manifest>